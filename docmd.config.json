{
  "title": "Slipstream Transit",
  "url": "https://jkswoods.github.io/slipstream-transit/",
  "base": "/slipstream-transit/",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "versions": {
    "current": "index",
    "position": "sidebar-top",
    "all": [
      {
        "id": "index",
        "dir": "docs",
        "label": "Choose Hytale version"
      },
      {
        "id": "hytale0.7",
        "dir": "versions/hytale0.7",
        "label": "Hytale 0.7 (latest)"
      }
    ]
  },
  "theme": {
    "appearance": "light",
    "customCss": [
      "/assets/publication.css",
      "/assets/brand.css"
    ]
  },
  "layout": {
    "optionsMenu": {
      "components": {
        "themeSwitch": false,
        "search": true
      }
    },
    "spa": false
  },
  "plugins": {
    "ai": {
      "enabled": false,
      "assistant": false
    },
    "analytics": false,
    "search": {
      "semantic": false
    },
    "git": {
      "commitHistory": false,
      "lastUpdated": false,
      "editLink": false,
      "branch": "docs"
    },
    "seo": {},
    "sitemap": {}
  },
  "markdown": {
    "breaks": false
  },
  "minify": false,
  "logo": {
    "light": "/assets/hytale0.7/logo.svg",
    "dark": "/assets/hytale0.7/logo.svg",
    "href": "/",
    "alt": "Slipstream Transit",
    "height": "56px"
  },
  "security": {
    "html": "allow"
  },
  "redirects": {
    "/recipes": "/slipstream-transit/hytale0.7/recipes/",
    "/build-and-release": "/slipstream-transit/hytale0.7/build-and-release/",
    "/changelog": "/slipstream-transit/hytale0.7/changelog/",
    "/troubleshooting": "/slipstream-transit/hytale0.7/troubleshooting/",
    "/gallery": "/slipstream-transit/hytale0.7/gallery/",
    "/getting-started": "/slipstream-transit/hytale0.7/getting-started/",
    "/configuration": "/slipstream-transit/hytale0.7/configuration/",
    "/progression": "/slipstream-transit/hytale0.7/progression/",
    "/installation": "/slipstream-transit/hytale0.7/installation/",
    "/features": "/slipstream-transit/hytale0.7/features/"
  }
}
